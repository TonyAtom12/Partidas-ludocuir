# Token Bearer de tu aplicación registrada en boardgamegeek.com/applications
# Sin token, /api/search devuelve juegos de ejemplo (modo mock).
BGG_TOKEN=

# Avisos (notificaciones push). Genera las claves UNA vez con:  npx web-push generate-vapid-keys
# La clave pública va también con prefijo VITE_ (la lee el navegador); la privada SOLO en el servidor.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contacto del remitente (https://... o mailto:...). Por defecto, la URL de la web.
VAPID_SUBJECT=
